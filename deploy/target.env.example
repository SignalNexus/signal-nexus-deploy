# Names only. This file has no secret values and no host name.

# Variables
DEPLOY_ANALYTICS=
ANALYTICS_SSH_USER=
ANALYTICS_CORE_DIRECTORY=
ANALYTICS_VENUE_DIRECTORY=
BUILTIN_VENUES=

# Secrets. When venueadd/venues.yaml lists a venue, store the customer's
# fine-grained token as VENUEADD_READ_TOKEN. The caller passes it as
# venueadd_read_token. Signal Nexus does not keep the token.
# VENUEADD_READ_TOKEN
# ANALYTICS_SSH_HOST
# ANALYTICS_SSH_PRIVATE_KEY
# ANALYTICS_SSH_HOST_FINGERPRINT
# ANALYTICS_API_SECRET
# ANALYTICS_DB_PASSWORD
# RENDER_HEALTH_URL
# CADDY_SITE_ADDRESS
# KILL_SWITCH
# ANALYTICS_ARCUS_ADDRESS
# ARCUS_ADDRESS
# ARCUS_SIGNING_KEY
# ANALYTICS_MEXC_API_KEY
# ANALYTICS_MEXC_API_SECRET
# ANALYTICS_MEXC_FUTURES_API_KEY
# ANALYTICS_MEXC_FUTURES_API_SECRET
# MEXC_API_KEY
# MEXC_API_SECRET
# MEXC_FUTURES_API_KEY
# MEXC_FUTURES_API_SECRET

# Environment files the workflow writes beside the core directory.
analytics.env
arcus.env
mexc.env
site.env
